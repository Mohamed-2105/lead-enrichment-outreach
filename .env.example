# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by git. Never commit it, never paste it in a chat, never write these values in the code.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# Optional: web search, used to find websites, retailers and headcounts (https://serper.dev)
SERPER_API_KEY=your-serper-key-here

# Optional: headcount and contacts (Apollo > Settings > Integrations > API).
# The people search needs a MASTER key.
APOLLO_API_KEY=your-apollo-key-here

# Optional, only for create_drafts.py: YOUR OWN address. Drafts are addressed to you in the code"
DRAFT_RECIPIENT=you@example.com

# Optional: the company the emails are written for, and what it does in one sentence.
# Leave both empty to use the neutral example "Acme Connect".
SENDER_COMPANY=
PRODUCT_PITCH=

# Optional: test run on the first N companies, if credits are rare (empty or 0 = all of them)
MAX_LEADS=
